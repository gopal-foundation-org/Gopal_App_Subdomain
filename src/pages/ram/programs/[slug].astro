---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProgramLanding from '../../../components/ProgramLanding.astro';
import {programSeo} from '../../../lib/public-programs/model.mjs';
import content from '../../../../public/content/ram.json';
export function getStaticPaths() {
  return content.programs.filter(p => p.active).map(program => ({params:{slug:program.slug},props:{program}}));
}
const { program } = Astro.props;
const seo=programSeo(program,'ram');
---
<BaseLayout title={seo.title} description={seo.description} canonicalUrl={seo.canonical} socialImage={seo.socialImage} indexable={seo.index}>
  <ProgramLanding program={program} content={content} scope="ram" />
</BaseLayout>
