---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpenPrograms from '../components/OpenPrograms.astro';
import website from '../../public/content/website.json';
const page=website.initiativesPage;
---
<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <section class="ux-directory-hero" data-initiatives-hero>
    <div class="container"><p class="eyebrow" data-website-text="initiativesPage.eyebrow">{page.eyebrow}</p><h1 data-website-text="initiativesPage.title">{page.title}</h1><p class="lede" data-website-text="initiativesPage.introduction">{page.introduction}</p></div>
  </section>
  <OpenPrograms filters heading="Choose Your Program" intro="Register now, join a waitlist or tell us what you are interested in." />
  <section class="ux-section ux-about-band"><div class="container"><h2>Explore Our Initiatives</h2><p>Learn more about <a href="/ram/">RAM</a>, <a href="/sita/">SITA</a> and <a href="/community-programs/">Community Programs</a>.</p></div></section>
</BaseLayout>
