---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpenPrograms from '../components/OpenPrograms.astro';
import {cardsMarkup,featuredMarkup} from '../lib/website/model.mjs';
import {homeTestimonials,homeResources} from '../lib/public-programs/surfaces.mjs';
import website from '../../public/content/website.json';
import ram from '../../public/content/ram.json';
import sita from '../../public/content/sita.json';
import feedback from '../data/testimonials.json';
const {home}=website;
---
<BaseLayout title={home.seoTitle} description={home.seoDescription}>
  <div class="ux-home">
    <section class="hero ux-hero" data-home-hero style={`--hero-image:url(${home.image})`}>
      <div class="container hero__inner"><div class="hero__content">
        <p class="eyebrow" data-website-text="home.eyebrow">{home.eyebrow}</p>
        <h1 data-website-text="home.headline">{home.headline}</h1>
        <p class="lede" data-website-text="home.description">{home.description}</p>
        <div class="actions">
          <a class="button button--primary" href={home.primaryCta.href} data-website-href="home.primaryCta.href" data-website-text="home.primaryCta.label" hidden={!home.primaryCta.enabled}>{home.primaryCta.label}</a>
          <a class="button" href={home.secondaryCta.href} data-website-href="home.secondaryCta.href" data-website-text="home.secondaryCta.label" hidden={!home.secondaryCta.enabled}>{home.secondaryCta.label}</a>
        </div>
      </div></div>
    </section>
    <div data-home-section="featured" hidden={!home.sections.find(section=>section.id==='featured')?.enabled}>
      <OpenPrograms limit={6} heading={home.featuredHeading} intro={home.featuredIntro} headingPath="home.featuredHeading" introPath="home.featuredIntro" />
    </div>
    <div class="home-sections">
      <section class="ux-section" id="initiatives" data-home-section="initiatives" aria-labelledby="initiatives-heading">
        <div class="container"><div class="ux-section-heading"><div><h2 id="initiatives-heading" data-website-text="home.initiativesHeading">{home.initiativesHeading}</h2><p data-website-text="home.initiativesIntro">{home.initiativesIntro}</p></div></div><div class="initiative-grid" data-website-cards="home" set:html={cardsMarkup(website,true)} /></div>
      </section>
      <div data-ux-home-testimonials data-home-after="initiatives" style={`order:${home.sections.findIndex(section=>section.id==='initiatives')}`} set:html={homeTestimonials(feedback,{ram,sita})} />
      <div data-ux-home-resources data-home-after="initiatives" style={`order:${home.sections.findIndex(section=>section.id==='initiatives')}`} set:html={homeResources({ram,sita})} />
      <section class="ux-section ux-about-band" data-home-section="about" aria-labelledby="about-heading">
        <div class="container"><h2 id="about-heading" data-website-text="home.aboutHeading">{home.aboutHeading}</h2><p data-website-text="home.aboutSummary">{home.aboutSummary}</p><a class="ux-detail-link" href="/about/">About GOPAL Foundation &rarr;</a></div>
      </section>
      <section class="ux-section" data-home-section="values" aria-labelledby="values-heading">
        <div class="container"><div class="ux-section-heading"><h2 id="values-heading" data-website-text="home.valuesHeading">{home.valuesHeading}</h2></div><div class="ux-trust-grid">{home.values.map((value,index)=><div><h3 data-website-text={`home.values.${index}.title`}>{value.title}</h3><p data-website-text={`home.values.${index}.description`}>{value.description}</p></div>)}</div></div>
      </section>
    </div>
    <section class="ux-section ux-curated-links" data-home-section="featured" hidden={!home.sections.find(section=>section.id==='featured')?.enabled}><div class="container"><div class="ux-section-heading"><h2>Explore More</h2></div><div class="ux-related-grid" data-website-featured set:html={featuredMarkup(website)} /></div></section>
  </div>
</BaseLayout>
